# Copy this file to .env and adjust. Your Garmin password does NOT go here;
# run `python backend/login.py` once instead and it stores a login token.

# Heart rate that splits easy from hard running (bpm).
AEROBIC_THRESHOLD=158

# Used only when Garmin has no training load for an activity (bpm).
MAX_HR=195

# How far back the first sync goes.
ACTIVITY_BACKFILL_DAYS=180
DAILY_BACKFILL_DAYS=60
HEALTH_HISTORY_DAYS=365
VO2MAX_BACKFILL_DAYS=1095

# How often to pull new data from Garmin while the server runs.
SYNC_INTERVAL_MINUTES=60

# 0.0.0.0 makes the dashboard reachable from other devices on your wifi.
HOST=0.0.0.0
PORT=8000

# Optional, but recommended with HOST=0.0.0.0: without it anyone on the same network can open the dashboard.
# If set, the dashboard opens with a login page that asks for this password.
DASHBOARD_PASSWORD=
# Optional. If set, the login page asks for this username too; empty means password only.
DASHBOARD_USERNAME=

# Where the login token and database live.
TOKEN_DIR=~/.garminconnect
DB_PATH=data/athlete.db
